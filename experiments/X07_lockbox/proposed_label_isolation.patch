+def labels_for_split(path, split, expected_ids):
+    """Select CSV row numbers without labels, then parse only selected labels."""
+    import pandas as pd
+    identity=pd.read_csv(path,usecols=['video_id','clip_id','mode'],dtype=str,keep_default_na=False)
+    selected=identity[identity['mode']==split]
+    ids=[f'{r.video_id}__{r.clip_id}' for r in selected.itertuples()]
+    if len(ids)!=len(expected_ids) or set(ids)!=set(expected_ids):
+        raise RuntimeError('STOP metric identity mismatch before label access')
+    # skiprows addresses physical lines. Fail closed on multiline CSV records.
+    with Path(path).open(newline='') as stream:
+        line_count=sum(1 for _ in stream)
+    if line_count!=len(identity)+1:
+        raise RuntimeError('STOP CSV is not one physical line per record')
+    skip=[int(i)+1 for i in identity.index if i not in selected.index]
+    frame=pd.read_csv(path,usecols=['video_id','clip_id','label'],
+        dtype={'video_id':str,'clip_id':str,'label':float},skiprows=skip)
+    result={f'{r.video_id}__{r.clip_id}':float(r.label) for r in frame.itertuples()}
+    if set(result)!=set(expected_ids):
+        raise RuntimeError('STOP metric label identities differ')
+    return result
+
